NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
SESSION_TTL_SECONDS=86400
# Required in production, optional in development (generated per process if absent).
# Generate a private value with: openssl rand -base64 32
# CSRF_SECRET=

# Use private Atlas database-user credentials, not your Atlas website login.
# Percent-encode reserved characters in credentials embedded in the URI.
MONGODB_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_HOST>/?authSource=admin
MONGODB_DB_NAME=marriage_suite_dev

# Manager invitations and password recovery. Development defaults to a private
# server/.local/outbox; nothing is sent externally in outbox mode.
EMAIL_MODE=outbox
MANAGER_INVITE_TTL_SECONDS=172800
PASSWORD_RESET_TTL_SECONDS=3600
# Optional in development; generated/persisted under server/.local if absent.
# Required for production Resend. Generate privately: openssl rand -hex 32
# EMAIL_ENCRYPTION_KEY=
# Resend requires a verified sender. Non-production also requires an exact
# comma-separated recipient allowlist. Never commit real values.
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_ALLOWED_RECIPIENTS=
# Production defaults to EMAIL_MODE=disabled. Explicitly select resend to enable
# team setup/recovery; outbox is rejected in production.

# Family invitation links use a separate stable 32-byte hex key.
# Development creates an ignored server/.local/invitation-key if omitted.
# Production invitation routes are unavailable until configured. Back up securely.
# INVITATION_ENCRYPTION_KEY=
